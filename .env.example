DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Small is the balanced default. Choose tiny_streaming for lowest CPU use.
STT_MODEL=small_streaming
# Extra pause after a completed segment, so thinking pauses don't cut the turn.
STT_END_PAUSE_SECONDS=1.2
# Optional specific names/terms, comma-separated; leave blank for ordinary speech.
STT_KEYTERMS=
# Native Moonshine CPU sessions: one inference thread, leaves CPU for your work.
MOONSHINE_ORT_SINGLE_THREAD=1
TTS_MODEL=KittenML/kitten-tts-nano-0.8-int8
TTS_VOICE=Jasper
TTS_SPEED=0.95
TTS_THREADS=2
# PortAudio device name/index; blank uses system defaults. See --devices.
INPUT_DEVICE=
OUTPUT_DEVICE=
PROACTIVE_SECONDS=90
# 0 disables saving chat history. Audio recordings are never saved by 2tor.
SAVE_HISTORY=0
# Entire process tree, conservative target; measured with psutil RSS.
MEMORY_LIMIT_MB=2800
CORRECTION_MODE=gentle
